    if n1 >= n2 and n1 >= n3:
        return n1
    elif n2 >= n1 and n2 >= n3:
        return n2
    else:
        return n3
 
def nota_menor(n1, n2, n3):
    if n1 <= n2 and n1 <= n3:
        return n1
    elif n2 <= n1 and n2 <= n3:
        return n2
    else:
        return n3

def determinar_aprobacion(calificaciones):
    promedio = calcular_promedio(calificaciones)
    if promedio >= 70:
        return "Aprobado"
    else:
        return "Reprobado"

